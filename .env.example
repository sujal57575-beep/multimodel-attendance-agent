# Environment Configuration
# Copy this to .env and fill in values. NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
FLASK_DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────
# Default: ./storage/attendance.db (auto-created)
# DATABASE_PATH=./storage/attendance.db

# ── Upload Limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500

# ── Computer Vision ────────────────────────────────────────────────────────
CV_BACKEND=yolov8                  # yolov8 | haar | hog
YOLO_MODEL=yolov8n.pt              # downloads automatically on first run
FRAME_SAMPLE_RATE=5                # analyse every N frames (higher = faster, less accurate)
ATTENDANCE_THRESHOLD_SECONDS=120   # min sustained presence to mark attendance
DETECTION_CONFIDENCE=0.45

# ── Engagement Weights (must sum ≤ 1.0) ───────────────────────────────────
EW_PRESENCE=0.35
EW_MOTION=0.25
EW_AUDIO=0.25
EW_HEAD_POSE=0.15
ENGAGEMENT_WINDOW_SECONDS=60

# ── Optional: Google Gemini AI ─────────────────────────────────────────────
# Leave blank to use offline rule-based recommendations only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Text-to-Speech ─────────────────────────────────────────────────────────
TTS_ENABLED=true
TTS_ENGINE=pyttsx3

# ── Code Execution (DISABLED BY DEFAULT for security) ─────────────────────
CODE_EXEC_ENABLED=false
CODE_EXEC_TIMEOUT=10

# ── Privacy & Retention ────────────────────────────────────────────────────
DATA_RETENTION_DAYS=90
FACIAL_RECOGNITION_ENABLED=false   # requires explicit consent and lawful basis

# ── Auth ───────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
